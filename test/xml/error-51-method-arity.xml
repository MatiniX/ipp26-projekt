<?xml version="1.0" encoding="UTF-8"?>
<program language="SOL26" description="Objekt pozná metódu do:and: (2 parametre).">
  <class name="MultiArg" parent="Object">
    <method selector="do:and:">
      <block arity="2">
        <parameter order="1" name="x"/>
        <parameter order="2" name="y"/>
        <assign order="1">
          <var name="_"/>
          <expr>
            <send selector="print">
              <expr>
                <literal class="String" value="Two arguments"/>
              </expr>
            </send>
          </expr>
        </assign>
      </block>
    </method>
  </class>
  <class name="Main" parent="Object">
    <method selector="run">
      <block arity="0">
        <assign order="1">
          <var name="obj"/>
          <expr>
            <send selector="new">
              <expr>
                <literal class="class" value="MultiArg"/>
              </expr>
            </send>
          </expr>
        </assign>
        <assign order="2">
          <var name="_"/>
          <expr>
            <send selector="do:">
              <expr>
                <var name="obj"/>
              </expr>
              <arg order="1">
                <expr>
                  <literal class="String" value="A single argument instead of two"/>
                </expr>
              </arg>
            </send>
          </expr>
        </assign>
        <assign order="3">
          <var name="_"/>
          <expr>
            <send selector="do:and:but:">
              <expr>
                <var name="obj"/>
              </expr>
              <arg order="1">
                <expr>
                  <literal class="Integer" value="1"/>
                </expr>
              </arg>
              <arg order="2">
                <expr>
                  <literal class="Integer" value="2"/>
                </expr>
              </arg>
              <arg order="3">
                <expr>
                  <literal class="Integer" value="3"/>
                </expr>
              </arg>
            </send>
          </expr>
        </assign>
      </block>
    </method>
  </class>
</program>
